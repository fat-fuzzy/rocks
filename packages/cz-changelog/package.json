{
	"name": "@fat-fuzzy/cz-changelog",
	"package": "@fat-fuzzy/cz-changelog",
	"version": "0.1.15",
	"description": "Commitizen adapter ADAPTED FROM the conventional-changelog format.",
	"main": "index.js",
	"scripts": {
		"commit": "git-cz",
		"test:tofix": "mocha *.test.js",
		"test": "echo \"@fat-fuzzy/cz-changelog: no tests specified\"",
		"format": "prettier --write --ignore-path=../../.prettierignore ."
	},
	"homepage": "https://github.com/fat-fuzzy/rocks/tree/main/packages/cz-changelog",
	"repository": {
		"type": "git",
		"url": "https://github.com/fat-fuzzy/rocks.git"
	},
	"engineStrict": true,
	"engines": {
		"node": ">= 26"
	},
	"author": "Jim Cummins <jimthedev@gmail.com>",
	"license": "MIT",
	"peerDependencies": {
		"@eslint/compat": "^1.0.0"
	},
	"dependencies": {
		"chalk": "6.0.0",
		"commitizen": "4.3.2",
		"conventional-commit-types": "3.0.0",
		"longest": "2.0.1",
		"word-wrap": "1.2.5"
	},
	"devDependencies": {
		"@eslint/compat": "2.0.3",
		"@fat-fuzzy/config": "workspace:*",
		"@types/chai": "5.2.3",
		"@types/mocha": "10.0.10",
		"chai": "6.3.0",
		"cosmiconfig": "10.0.1",
		"mocha": "12.0.3",
		"mock-require": "3.0.3",
		"semver": "7.8.5"
	},
	"optionalDependencies": {
		"@commitlint/load": "21.2.3"
	},
	"config": {
		"commitizen": {
			"path": "./index.js"
		}
	}
}
