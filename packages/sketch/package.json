{
	"package": "@fat-fuzzy/sketch",
	"name": "@fat-fuzzy/sketch",
	"author": "Patricia Boh",
	"version": "0.1.44",
	"scripts": {
		"dev": "vite dev",
		"build:ts": "tsc --outDir dist/lib --declarationDir dist/types --declaration true",
		"build": "vite build && pnpm package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:css": "./node_modules/@fat-fuzzy/config/node_modules/.bin/stylelint ./src/lib/styles/css/**/*.css &> ./logs/stylelint-css.log",
		"lint:scss": "./node_modules/@fat-fuzzy/config/node_modules/.bin/stylelint ./src/lib/styles/scss/**/*.scss &> ./logs/stylelint-scss.log",
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"test": "pnpm test:e2e",
		"test:unit": "vitest run",
		"test:types": "vitest run --typecheck",
		"test:coverage": "vitest --ui",
		"test:report": "vitest run --reporter=verbose",
		"test:e2e": "NODE_ENV=test playwright test",
		"test:e2e:ui": "NODE_ENV=test playwright test --ui",
		"test:e2e:report": "NODE_ENV=test playwright test --reporter=html"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./sketch": "./dist/index.js"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"@sveltejs/kit": "3.0.0-next.27",
		"svelte": "5.57.1"
	},
	"devDependencies": {
		"@eslint/compat": "2.0.3",
		"@fat-fuzzy/config": "workspace:*",
		"@fat-fuzzy/gfx": "workspace:*",
		"@fat-fuzzy/intl": "workspace:*",
		"@fat-fuzzy/style": "workspace:*",
		"@fat-fuzzy/ui": "workspace:*",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/package": "3.0.0-next.8",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"publint": "0.3.18",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vite": "8.1.5",
		"vitest": "5.0.1"
	},
	"main": "./dist/index.js",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"engines": {
		"node": ">= 26"
	}
}
