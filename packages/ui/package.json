{
	"package": "@fat-fuzzy/ui",
	"name": "@fat-fuzzy/ui",
	"version": "0.1.109",
	"author": "Patricia Boh",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm package",
		"generate:validators": "ff-validation",
		"prebuild": "ff-validation",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"test": "pnpm test:unit && pnpm test:browser && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:types": "vitest run --typecheck",
		"test:coverage": "vitest --ui",
		"test:browser": "vitest run --config=vitest.browser.config.ts",
		"test:browser:ui": "vitest --config=vitest.browser.ui.config.ts",
		"test:e2e": "NODE_ENV=test playwright test",
		"test:ui": "NODE_ENV=test playwright test --ui",
		"test:dev:unit": "vitest",
		"test:report": "NODE_ENV=test playwright test --reporter=html"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"dependencies": {
		"dompurify": "3.4.16"
	},
	"peerDependencies": {
		"@sveltejs/kit": "3.0.0-next.28",
		"svelte": "5.57.1"
	},
	"devDependencies": {
		"@eslint/compat": "2.0.3",
		"@fat-fuzzy/config": "workspace:*",
		"@fat-fuzzy/intl": "workspace:*",
		"@fat-fuzzy/style": "workspace:*",
		"@fat-fuzzy/validation": "workspace:*",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-auto": "8.0.0-next.4",
		"@sveltejs/kit": "3.0.0-next.28",
		"@sveltejs/package": "3.0.0-next.8",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@vitest/browser": "5.0.1",
		"@vitest/browser-playwright": "5.0.1",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/ui": "5.0.1",
		"mdsvex": "0.12.7",
		"postcss": "8.5.27",
		"publint": "0.3.18",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vitest": "5.0.1",
		"vitest-browser-svelte": "2.2.1"
	},
	"main": "./dist/index.js",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"engines": {
		"node": ">= 26"
	}
}
