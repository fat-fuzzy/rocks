{
	"package": "@fat-fuzzy/prose",
	"name": "@fat-fuzzy/prose",
	"version": "0.1.52",
	"description": "UI for writing and reading using markdown",
	"author": "Patricia Boh",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"lint": "prettier --check . && eslint .",
		"test": "pnpm test:unit",
		"test:unit": "vitest run",
		"test:types": "vitest run --typecheck",
		"test:coverage": "vitest --ui",
		"test:e2e": "NODE_ENV=test playwright test",
		"test:ui": "NODE_ENV=test playwright test --ui",
		"test:dev:unit": "vitest",
		"test:report": "NODE_ENV=test playwright test --reporter=html"
	},
	"main": "./dist/index.js",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#tests": "./tests/index.js",
		"#tests/*": "./tests/*",
		"#types": "./src/lib/types/index.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "3.0.0-next.27",
		"svelte": "5.57.1"
	},
	"dependencies": {
		"@tiptap/core": "3.31.3",
		"@tiptap/extension-bold": "3.31.3",
		"@tiptap/extension-link": "3.31.3",
		"@tiptap/extension-list": "3.31.3",
		"@tiptap/extension-text-style": "3.31.3",
		"@tiptap/extension-typography": "3.31.3",
		"@tiptap/pm": "3.31.3",
		"@tiptap/starter-kit": "3.31.3",
		"@tiptap/static-renderer": "3.31.3",
		"dompurify": "3.4.16"
	},
	"devDependencies": {
		"@eslint/compat": "2.0.3",
		"@fat-fuzzy/config": "workspace:*",
		"@fat-fuzzy/style": "workspace:*",
		"@fat-fuzzy/ui": "workspace:*",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/package": "3.0.0-next.8",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/ui": "5.0.1",
		"mdsvex": "0.12.7",
		"publint": "0.3.18",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vite": "8.1.5",
		"vitest": "5.0.1"
	}
}
