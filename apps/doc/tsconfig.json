{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"declaration": true,
		"outDir": "./dist",
		"rootDir": "./",
		"declarationDir": "./dist/types"
	}
}
