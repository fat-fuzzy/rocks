{
	"name": "@fat-fuzzy/vital",
	"version": "0.1.3",
	"type": "module",
	"private": true,
	"description": "Vital tools for growth, reflection and story.",
	"main": "index.js",
	"author": "Patricia Boh",
	"scripts": {
		"dev": "vite dev",
		"predev": "pnpm generate",
		"gen:schemas": "node scripts/schemas-to-ajv.js",
		"gen:validators": "ff-validation",
		"gen:types": "node scripts/schemas-to-ts.js",
		"generate": "pnpm gen:schemas && pnpm gen:validators && pnpm gen:types",
		"prebuild": "pnpm generate",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "npx wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"prepare": "svelte-kit sync || echo '' && husky",
		"cz": "cz",
		"test": "pnpm test:unit && pnpm test:browser && pnpm test:e2e",
		"test:dev:unit": "vitest",
		"test:unit": "vitest run",
		"test:types": "vitest run --typecheck",
		"test:coverage": "vitest --ui",
		"test:report": "vitest run --reporter=verbose",
		"test:browser": "vitest run --config=vitest.browser.config.ts",
		"test:browser:ui": "vitest --config=vitest.browser.ui.config.ts",
		"test:e2e": "NODE_ENV=test playwright test",
		"test:e2e:ui": "NODE_ENV=test playwright test --ui",
		"test:e2e:report": "NODE_ENV=test playwright test --reporter=html"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#tests": "./tests/index.js",
		"#tests/*": "./tests/*",
		"#config/*": "./src/config/*",
		"#data/*": "./src/data/*",
		"#types": "./src/lib/types/index.ts"
	},
	"devDependencies": {
		"@changesets/cli": "2.30.0",
		"@eslint/compat": "2.1.0",
		"@fat-fuzzy/config": "workspace:*",
		"@fat-fuzzy/intl": "workspace:*",
		"@fat-fuzzy/prose": "workspace:*",
		"@fat-fuzzy/style": "workspace:*",
		"@fat-fuzzy/ui": "workspace:*",
		"@fat-fuzzy/validation": "workspace:*",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-cloudflare": "8.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "26.6.4",
		"@vitest/browser": "5.0.1",
		"@vitest/browser-playwright": "5.0.1",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/ui": "5.0.1",
		"ajv-errors": "3.0.0",
		"ajv-formats": "3.0.1",
		"commitizen": "4.3.1",
		"cz-conventional-changelog": "3.3.0",
		"eslint": "10.11.0",
		"globals": "17.7.0",
		"hast-util-from-html": "2.0.3",
		"hast-util-to-html": "9.0.5",
		"hast-util-to-mdast": "10.1.2",
		"husky": "9.1.7",
		"json-schema-to-typescript": "15.0.4",
		"mdast-util-to-hast": "13.2.1",
		"mdast-util-to-markdown": "2.1.2",
		"mdsvex": "0.12.7",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"svelte-preprocess": "6.0.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vite": "8.1.5",
		"vitest": "5.0.1",
		"vitest-browser-svelte": "3.0.0",
		"wrangler": "4.71.0"
	}
}
